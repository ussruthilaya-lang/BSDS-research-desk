{
  "title": "Research Desk",
  "uid": "researchdesk",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Provider violations (must be 0)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rd_provider_violations_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway queue depth",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rd_gateway_queue_depth",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider calls per minute (limit 20)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(rd_provider_calls_total[1m]) * 60",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs by status",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rd_jobs_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Searches by source (cache, merged, provider)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (source) (rd_searches_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway drops by reason",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rd_gateway_drops_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Admission decisions",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (decision) (rd_admission_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lease expiries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rd_lease_expiries_total)",
          "refId": "A",
          "legendFormat": "{{status}}{{reason}}{{kind}}{{source}}"
        }
      ]
    }
  ]
}